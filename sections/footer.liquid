{% liquid
  assign contact_email = section.settings.contact_email | default: settings.contact_email | default: 'info@avelatr.com'
  assign brand_text = section.settings.brand_text
  if brand_text == blank and shop.description != blank
    assign brand_text = shop.description
  endif
  assign contact_heading = section.settings.contact_heading
  if contact_heading == blank
    assign contact_heading = 'footer.contact' | t
  endif

  assign whatsapp_url = settings.whatsapp_url
  if whatsapp_url == blank and shop.phone != blank
    assign whatsapp_digits = shop.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
    if whatsapp_digits != blank
      assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
    endif
  endif
  if whatsapp_url != blank
    unless whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp'
      assign whatsapp_url = blank
    endunless
  endif

  assign has_contact = false
  if section.settings.show_contact
    if contact_email != blank or whatsapp_url != blank or settings.trust_support != blank
      assign has_contact = true
    endif
  endif

  assign has_trust = false
  if section.settings.show_trust
    if settings.trust_shipping != blank or settings.trust_returns != blank or settings.trust_payment != blank or settings.trust_support != blank or settings.free_shipping_threshold != blank
      assign has_trust = true
    endif
  endif

  assign shop_fallback = 'yeni-sezon,tesettur-elbise,tesettur-takim,tesettur-tunik,tesettur-pantolon,dis-giyim,sal-esarp,indirim' | split: ','
  assign menu_blocks = 0
  for block in section.blocks
    if block.type == 'menu'
      assign menu_blocks = menu_blocks | plus: 1
    endif
  endfor
%}

<footer class="footer full-width band band--ash">
  {% render 'footer-rose' %}
  <div class="footer__grid{% if shop.customer_accounts_enabled %} footer__grid--with-account{% endif %}">
    <div class="footer__brand-col">
      <a class="footer__brand" href="{{ routes.root_url }}">
        {% render 'brand-logo' %}
      </a>
      {% if brand_text != blank %}
        <div class="footer__lede-stack">
          <p class="footer__lede">{{ brand_text | escape }}</p>
          {% assign lede_echoes = '0.55,0.50,0.45,0.40,0.35,0.30,0.25,0.20,0.15,0.10,0.07,0.04' | split: ',' %}
          {% for echo_opacity in lede_echoes %}
            <p class="footer__lede footer__lede--echo" style="--lede-echo: {{ echo_opacity }};" aria-hidden="true">{{ brand_text | escape }}</p>
          {% endfor %}
        </div>
      {% endif %}
      <div class="footer__sign footer__sign--brand" aria-hidden="true">
        <img
          src="{{ 'footer-signature.png' | asset_url }}"
          alt=""
          width="1382"
          height="662"
          loading="lazy"
        >
      </div>
    </div>

    {% if menu_blocks > 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          {% liquid
            assign col_heading = block.settings.heading
            if col_heading == blank and block.settings.menu != blank
              assign col_heading = block.settings.menu.title
            endif
            if col_heading == blank
              assign col_heading = 'footer.help' | t
            endif
          %}
          <nav class="footer__col" {{ block.shopify_attributes }} aria-label="{{ col_heading | escape }}">
            <p class="eyebrow">{% render 'turkish-upper', text: col_heading %}</p>
            <ul class="footer__links">
              {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                {% for link in block.settings.menu.links %}
                  {% unless link.url contains '/pages/contact' %}
                    <li>
                      <a href="{{ link.url }}">{% render 'turkish-upper', text: link.title %}</a>
                    </li>
                  {% endunless %}
                {% endfor %}
              {% elsif block.settings.use_shop_fallback %}
                {% for handle in shop_fallback %}
                  {% assign shop_collection = collections[handle] %}
                  {% if shop_collection != blank and shop_collection.products_count > 0 %}
                    <li>
                      <a href="{{ shop_collection.url }}">{% render 'turkish-upper', text: shop_collection.title, handle: shop_collection.handle %}</a>
                    </li>
                  {% endif %}
                {% endfor %}
              {% else %}
                {% if pages['hakkimizda'] != blank %}
                  <li>
                    <a href="{{ pages['hakkimizda'].url }}">{% render 'turkish-upper', text: pages['hakkimizda'].title %}</a>
                  </li>
                {% endif %}
                {% if pages['kargo-ve-iade'] != blank %}
                  <li>
                    <a href="{{ pages['kargo-ve-iade'].url }}">{% render 'turkish-upper', text: pages['kargo-ve-iade'].title %}</a>
                  </li>
                {% endif %}
                {% if pages['beden-rehberi'] != blank %}
                  <li>
                    <a href="{{ pages['beden-rehberi'].url }}">{% render 'turkish-upper', text: pages['beden-rehberi'].title %}</a>
                  </li>
                {% endif %}
                {% if blogs['stil-rehberi'] != blank %}
                  <li>
                    <a href="{{ blogs['stil-rehberi'].url }}">{% render 'turkish-upper', text: blogs['stil-rehberi'].title %}</a>
                  </li>
                {% endif %}
                <li>
                  <a href="{{ routes.search_url }}">{% assign search_label = 'general.search' | t %}{% render 'turkish-upper', text: search_label %}</a>
                </li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      {% endfor %}
    {% else %}
      <nav class="footer__col" aria-label="{{ 'footer.shop' | t }}">
        <p class="eyebrow">{% assign shop_label = 'footer.shop' | t %}{% render 'turkish-upper', text: shop_label %}</p>
        <ul class="footer__links">
          {% for handle in shop_fallback %}
            {% assign shop_collection = collections[handle] %}
            {% if shop_collection != blank and shop_collection.products_count > 0 %}
              <li>
                <a href="{{ shop_collection.url }}">{% render 'turkish-upper', text: shop_collection.title, handle: shop_collection.handle %}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
      <nav class="footer__col" aria-label="{{ 'footer.help' | t }}">
        <p class="eyebrow">{% assign help_label = 'footer.help' | t %}{% render 'turkish-upper', text: help_label %}</p>
        <ul class="footer__links">
          {% if pages['hakkimizda'] != blank %}
            <li>
              <a href="{{ pages['hakkimizda'].url }}">{% render 'turkish-upper', text: pages['hakkimizda'].title %}</a>
            </li>
          {% endif %}
          {% if pages['kargo-ve-iade'] != blank %}
            <li>
              <a href="{{ pages['kargo-ve-iade'].url }}">{% render 'turkish-upper', text: pages['kargo-ve-iade'].title %}</a>
            </li>
          {% endif %}
          {% if pages['beden-rehberi'] != blank %}
            <li>
              <a href="{{ pages['beden-rehberi'].url }}">{% render 'turkish-upper', text: pages['beden-rehberi'].title %}</a>
            </li>
          {% endif %}
          {% if blogs['stil-rehberi'] != blank %}
            <li>
              <a href="{{ blogs['stil-rehberi'].url }}">{% render 'turkish-upper', text: blogs['stil-rehberi'].title %}</a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}

    <div class="footer__col footer__col--aside">
        {% if has_contact %}
          <div class="footer__block">
            <p class="eyebrow">{% render 'turkish-upper', text: contact_heading %}</p>
            <ul class="footer__links">
              {% if whatsapp_url != blank %}
                <li>
                  <a class="footer__whatsapp" href="{{ whatsapp_url }}"{% if whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp' %} rel="noopener"{% endif %}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path fill="currentColor" d="M17.47 14.38c-.28-.14-1.67-.82-1.93-.92-.26-.1-.45-.14-.64.14-.19.28-.74.92-.9 1.1-.17.19-.33.21-.61.07-.28-.14-1.18-.43-2.25-1.39a8.4 8.4 0 0 1-1.55-1.92c-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.16.19-.28.28-.47.1-.19.05-.35-.02-.5-.07-.14-.64-1.54-.87-2.11-.23-.56-.46-.48-.64-.49h-.54c-.19 0-.5.07-.76.35s-1 1-1 2.43 1.02 2.82 1.17 3.02c.14.19 2.01 3.06 4.86 4.29 1.8.78 2.17.79 2.95.67.45-.07 1.67-.68 1.9-1.34.24-.66.24-1.22.17-1.34-.07-.11-.25-.18-.53-.32ZM12.04 21.8a9.8 9.8 0 0 1-4.97-1.36l-.36-.21-3.69.97.99-3.6-.23-.37a9.8 9.8 0 1 1 8.26 4.57Zm0-17.96a8.16 8.16 0 0 0-6.9 12.47l.14.23-.59 2.15 2.21-.58.22.13a8.16 8.16 0 1 0 4.92-14.4Z"/>
                    </svg>
                    {{ 'footer.whatsapp_support' | t }}
                  </a>
                </li>
              {% endif %}
              {% if contact_email != blank %}
                <li>
                  <a class="footer__email" href="mailto:{{ contact_email }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M3.5 6.5h17v11h-17z"/>
                      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="m3.5 7 8.5 6.2L20.5 7"/>
                    </svg>
                    {{ contact_email }}
                  </a>
                </li>
              {% endif %}
            </ul>
            {% if settings.trust_support != blank %}
              <p class="footer__hours">{{ settings.trust_support | escape }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>

    {% if shop.customer_accounts_enabled %}
      <nav class="footer__col footer__col--account" aria-label="{{ 'customers.account' | t }}">
        <p class="eyebrow">{% assign account_label = 'customers.account' | t %}{% render 'turkish-upper', text: account_label %}</p>
        {% render 'account-nav', class: 'footer__links' %}
      </nav>
    {% endif %}
  </div>

  {% if has_trust %}
    <ul class="footer__trust" role="list">
      {% if settings.trust_shipping != blank %}
        <li>
          <span class="footer__trust-label">{% assign trust_ship_label = 'trust.label_shipping' | t %}{% render 'turkish-upper', text: trust_ship_label %}</span>
          <span class="footer__trust-copy">{{ settings.trust_shipping | escape }}</span>
        </li>
      {% elsif settings.free_shipping_threshold != blank %}
        <li>
          <span class="footer__trust-label">{% assign trust_ship_label = 'trust.label_shipping' | t %}{% render 'turkish-upper', text: trust_ship_label %}</span>
          <span class="footer__trust-copy">{{ 'trust.free_shipping_html' | t: amount: settings.free_shipping_threshold }}</span>
        </li>
      {% endif %}
      {% if settings.trust_returns != blank %}
        <li>
          <span class="footer__trust-label">{% assign trust_return_label = 'trust.label_returns' | t %}{% render 'turkish-upper', text: trust_return_label %}</span>
          <span class="footer__trust-copy">{{ settings.trust_returns | escape }}</span>
        </li>
      {% endif %}
      {% if settings.trust_payment != blank %}
        <li>
          <span class="footer__trust-label">{% assign trust_pay_label = 'trust.label_payment' | t %}{% render 'turkish-upper', text: trust_pay_label %}</span>
          <span class="footer__trust-copy">{{ settings.trust_payment | escape }}</span>
        </li>
      {% endif %}
      {% if settings.trust_support != blank %}
        <li>
          <span class="footer__trust-label">{% assign trust_help_label = 'trust.label_support' | t %}{% render 'turkish-upper', text: trust_help_label %}</span>
          <span class="footer__trust-copy">{{ settings.trust_support | escape }}</span>
        </li>
      {% endif %}
    </ul>
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {% endif %}
  {% endfor %}

  <div class="footer__bottom">
    <div class="footer__copy">
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        <a href="{{ routes.root_url }}">{{ 'general.brand' | t }}</a>
        ·
        <a href="https://www.avelatr.com">avelatr.com</a>
      </p>
      <div class="footer__sign footer__sign--dock" aria-hidden="true">
        <img
          src="{{ 'footer-signature.png' | asset_url }}"
          alt=""
          width="1382"
          height="662"
          loading="lazy"
        >
      </div>
    </div>

    <nav class="footer__legal" aria-label="{{ 'footer.legal' | t }}">
      <ul>
        {% if pages['gizlilik-politikasi'] != blank %}
          <li>
            <a href="{{ pages['gizlilik-politikasi'].url }}">{% render 'turkish-upper', text: pages['gizlilik-politikasi'].title %}</a>
          </li>
        {% endif %}
        {% if pages['kullanim-kosullari'] != blank %}
          <li>
            <a href="{{ pages['kullanim-kosullari'].url }}">{% render 'turkish-upper', text: pages['kullanim-kosullari'].title %}</a>
          </li>
        {% endif %}
        {% if pages['kvkk-aydinlatma'] != blank %}
          <li>
            <a href="{{ pages['kvkk-aydinlatma'].url }}">{% render 'turkish-upper', text: pages['kvkk-aydinlatma'].title %}</a>
          </li>
        {% endif %}
        {% if pages['kargo-ve-iade'] != blank %}
          <li>
            <a href="{{ pages['kargo-ve-iade'].url }}">{% render 'turkish-upper', text: pages['kargo-ve-iade'].title %}</a>
          </li>
        {% endif %}
      </ul>
    </nav>

    {% if section.settings.show_payment_icons %}
      <div class="footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
        {% render 'payment-icons' %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .footer {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-lg);
    background: var(--color-surface);
    border-top: 1px solid var(--color-foreground);
  }

  .footer > :not(.footer-pattern) {
    position: relative;
    z-index: 1;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-foreground);
    margin-bottom: var(--space-sm);
    text-decoration: none;
  }

  .footer__lede-stack {
    max-width: 22rem;
  }

  .footer__lede {
    margin: 0;
    color: var(--color-foreground);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .footer__lede--echo {
    display: none;
  }

  .footer__sign {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    margin-top: 0.4rem;
    max-width: 14rem;
    pointer-events: none;
  }

  .footer__sign img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left bottom;
  }

  .footer__sign--brand {
    display: none;
  }

  .footer__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .footer__copy p {
    margin: 0;
  }

  .footer__sign--dock {
    margin-top: 0;
    max-width: 9.5rem;
  }

  .footer__sign--dock img {
    object-position: center bottom;
  }

  .footer__brand-col {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    height: 100%;
  }

  .footer__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .footer__col--aside {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
  }

  .footer__block .eyebrow {
    margin: 0;
  }

  .footer__hours {
    margin: 0.55rem 0 0;
    color: var(--color-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
  }

  .footer .account-nav {
    gap: 0.15rem;
  }

  .footer .account-nav a {
    min-height: 2.25rem;
  }

  .footer__links--social {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .footer__links--social .social-link {
    width: 2.5rem;
    min-width: 2.5rem;
    height: 2.5rem;
    min-height: 2.5rem;
    justify-content: center;
    border: 1px solid var(--color-foreground);
  }

  .footer__links--social .social-link svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer__whatsapp,
  .footer__email {
    gap: 0.5rem;
  }

  .footer__whatsapp svg,
  .footer__email svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  .footer__subhead {
    margin-top: var(--space-lg);
  }

  .footer__note {
    color: var(--color-secondary);
    font-size: 0.8125rem;
  }

  .footer a {
    color: var(--color-foreground);
    text-decoration: none;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
  }

  .footer__trust {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--color-foreground);
  }

  .footer__trust li {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.85rem 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__trust li:last-child {
    border-bottom: 0;
  }

  .footer__trust-label {
    flex: 0 0 5.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .footer__trust-copy {
    flex: 1;
    min-width: 0;
    color: var(--color-secondary);
    font-size: 0.8125rem;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .footer__legal {
    width: 100%;
  }

  .footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    filter: grayscale(1) saturate(0);
  }

  .footer__payment .payment-icon {
    display: block;
    box-sizing: border-box;
    width: 2.375rem;
    height: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-foreground);
    background: var(--color-background);
  }

  .footer__payment .payment-icon img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 0.08rem 0.1rem;
    object-fit: contain;
    object-position: center;
    filter: grayscale(1) saturate(0) contrast(1.7) brightness(0.88);
    mix-blend-mode: multiply;
  }

  @media screen and (min-width: 750px) {
    .footer__lede {
      line-height: 1.08;
    }

    .footer__lede--echo {
      display: block;
      pointer-events: none;
      opacity: var(--lede-echo);
    }

    .footer__sign--brand {
      display: flex;
      flex: 1 1 0;
      min-height: 0;
      max-width: min(100%, 18rem);
      margin-top: 0.25rem;
    }

    .footer__sign--brand img {
      max-height: 100%;
    }

    .footer__sign--dock {
      display: none;
    }

    .footer__copy {
      align-items: flex-start;
    }

    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    }

    .footer__grid--with-account {
      grid-template-columns: 1.3fr 1fr 1fr 1.05fr 0.9fr;
    }

    .footer__trust li {
      padding-block: 0.95rem;
    }

    .footer__trust-label {
      flex-basis: 7rem;
    }

    .footer__bottom {
      grid-template-columns: 1fr auto 1fr;
      text-align: left;
    }

    .footer__bottom > .footer__copy {
      justify-self: start;
    }

    .footer__legal {
      width: auto;
      justify-self: center;
    }

    .footer__payment {
      justify-self: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "t:labels.brand_text",
      "default": "Her Kumaşta Bir Hikâye, Her Hikâyede Sen"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:labels.contact_heading",
      "default": "Bize ulaşın"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "t:labels.contact_email",
      "default": "info@avelatr.com"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:labels.show_contact",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "t:labels.show_trust",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        },
        {
          "type": "checkbox",
          "id": "use_shop_fallback",
          "label": "t:labels.use_shop_fallback",
          "default": false
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
