{% doc %}
  Footer yüzeyini kaplayan yarı saydam kumaş deseni.

  @example
  {% render 'footer-rose' %}
{% enddoc %}

<div class="footer-pattern" aria-hidden="true">
  <svg preserveAspectRatio="none" focusable="false">
    <defs>
      <pattern id="FooterWeave" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M14 1.5 L26.5 14 L14 26.5 L1.5 14 Z" fill="none" stroke="currentColor" stroke-width="0.65"/>
        <path d="M14 8 L20 14 L14 20 L8 14 Z" fill="none" stroke="currentColor" stroke-width="0.45"/>
        <circle cx="14" cy="14" r="0.85" fill="currentColor"/>
        <circle cx="14" cy="1.5" r="0.55" fill="currentColor"/>
        <circle cx="26.5" cy="14" r="0.55" fill="currentColor"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#FooterWeave)"/>
  </svg>
</div>

{% stylesheet %}
  .footer-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    color: var(--color-foreground);
    opacity: 0.12;
    pointer-events: none;
  }

  .footer-pattern svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}
