{% liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
%}

{% if visible_blocks > 0 %}
  {% liquid
    assign chips_label = 'collections.title' | t
    if section.settings.heading != blank
      assign chips_label = section.settings.heading
    endif
  %}
  <nav class="category-chips full-width band band--ash" aria-label="{{ chips_label | escape }}">
    <div class="section-head">
      <span class="section-head__index">0{{ section.index }}</span>
      {% if section.settings.heading != blank %}
        <h2>{% render 'turkish-upper', text: section.settings.heading %}</h2>
      {% endif %}
    </div>
    <ul class="category-chips__list" role="list">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          <li {{ block.shopify_attributes }}>
            <a class="category-chips__card" href="{{ block.settings.collection.url }}">
              {% render 'category-chip-icon', icon: block.settings.icon, handle: block.settings.collection.handle %}
              <span class="category-chips__copy">
                <span class="category-chips__title">{% render 'turkish-upper', text: block.settings.collection.title, handle: block.settings.collection.handle %}</span>
                <span class="category-chips__count">{{ 'collections.product_count' | t: count: block.settings.collection.products_count }}</span>
              </span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .category-chips {
    padding-block: var(--space-xl);
    border-block: 1px solid var(--color-foreground);
  }

  .category-chips .section-head h2 {
    flex: 1;
  }

  .category-chips__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    margin: 0;
    background: var(--color-foreground);
    border: 1px solid var(--color-foreground);
  }

  .category-chips__card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.75rem;
    padding: 0.85rem 0.9rem;
    background: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .category-chips__icon {
    display: grid;
    place-items: center;
    flex: 0 0 3rem;
    box-sizing: border-box;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
  }

  .category-chips__icon svg {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
  }

  .category-chips__icon img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 0.12rem;
    object-fit: contain;
    object-position: center;
  }

  .category-chips__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }

  .category-chips__title {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .category-chips__count {
    color: var(--color-secondary);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .category-chips__card:hover .category-chips__icon,
  .category-chips__card:focus-visible .category-chips__icon {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .category-chips__card:hover .category-chips__icon img,
  .category-chips__card:focus-visible .category-chips__icon img {
    filter: invert(1);
  }

  @media screen and (min-width: 750px) {
    .category-chips__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.category_chips",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "auto", "label": "t:options.icon.auto" },
            { "value": "elbise", "label": "t:options.icon.elbise" },
            { "value": "takim", "label": "t:options.icon.takim" },
            { "value": "tunik", "label": "t:options.icon.tunik" },
            { "value": "pantolon", "label": "t:options.icon.pantolon" },
            { "value": "dis-giyim", "label": "t:options.icon.dis_giyim" },
            { "value": "sal", "label": "t:options.icon.sal" },
            { "value": "abiye", "label": "t:options.icon.abiye" },
            { "value": "indirim", "label": "t:options.icon.indirim" },
            { "value": "collection", "label": "t:options.icon.collection" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.category_chips"
    }
  ]
}
{% endschema %}
