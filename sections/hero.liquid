{%- liquid
  assign hero_loading = 'lazy'
  assign hero_priority = 'auto'
  if section.index == 1
    assign hero_loading = 'eager'
    assign hero_priority = 'high'
  endif
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
-%}

<div class="hero full-width{% if section.settings.image == blank %} hero--plain{% endif %}">
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: hero_loading,
          fetchpriority: hero_priority,
          alt: hero_alt
      }}
    </div>
  {% endif %}

  <div class="hero__stage">
    <span class="hero__index" aria-hidden="true">01</span>
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{% render 'turkish-upper', text: section.settings.eyebrow %}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{% render 'turkish-upper', text: section.settings.heading %}</h1>
    {% endif %}
  </div>

  <div class="hero__content">
    {% if section.settings.text != blank %}
      <div class="rte hero__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank or section.settings.secondary_label != blank %}
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}
          {% render 'button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            style: 'primary'
          %}
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          {% render 'button',
            label: section.settings.secondary_label,
            url: section.settings.secondary_link,
            style: 'secondary'
          %}
        {% endif %}
      </div>
    {% endif %}
    {% if section.settings.trust_text != blank %}
      <p class="hero__trust">{% render 'turkish-upper', text: section.settings.trust_text %}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    min-height: clamp(16.5rem, 46svh, 23.6rem);
    display: grid;
    align-items: stretch;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 18%;
    transform: scaleX(-1);
    filter: grayscale(0.2);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(0 0 0 / 0.58), rgb(0 0 0 / 0.18));
  }

  .hero--plain {
    min-height: clamp(13rem, 33svh, 18.9rem);
    background: var(--color-foreground);
    color: var(--color-background);
    grid-template-columns: 1fr;
  }

  .hero__stage,
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-lg) var(--page-margin);
  }

  .hero__index {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: rgb(255 255 255 / 0.55);
  }

  .hero__heading {
    font-size: clamp(1.85rem, 7vw, 3.4rem);
    line-height: 1.18;
    max-width: 100%;
    color: inherit;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .hero__text,
  .hero .eyebrow {
    color: inherit;
  }

  .hero__text {
    max-width: 28rem;
    opacity: 0.86;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero .button {
    background: var(--color-background);
    color: var(--color-foreground);
    border-color: var(--color-background);
  }

  .hero .button--secondary {
    background: transparent;
    color: var(--color-background);
    border-color: var(--color-background);
  }

  .hero__trust {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .hero__stage,
    .hero__content {
      padding-block: var(--space-sm);
      gap: var(--space-xs);
    }

    .hero__heading {
      font-size: clamp(1.45rem, 6vw, 2.15rem);
    }
  }

  @media screen and (min-width: 750px) {
    .hero:not(.hero--plain) {
      min-height: clamp(34rem, 72svh, 48rem);
      grid-template-columns: minmax(22rem, 0.95fr) minmax(0, 1.05fr);
      grid-template-rows: auto 1fr;
    }

    .hero--plain {
      min-height: clamp(26rem, 56svh, 36rem);
      grid-template-columns: 1fr;
    }

    .hero__media {
      position: relative;
      inset: auto;
      grid-column: 2;
      grid-row: 1 / -1;
      height: 100%;
      min-height: 100%;
    }

    .hero__media img {
      object-position: 45% 18%;
    }

    .hero__media::after {
      background: linear-gradient(to left, rgb(0 0 0 / 0.08), transparent 28%);
    }

    .hero__heading {
      font-size: clamp(2.1rem, 3.4vw, 3.6rem);
    }

    .hero__stage {
      grid-column: 1;
      grid-row: 1;
      padding: var(--space-2xl) var(--space-xl) var(--space-md);
    }

    .hero__content {
      grid-column: 1;
      grid-row: 2;
      justify-content: flex-end;
      padding: var(--space-md) var(--space-xl) var(--space-2xl);
      border-left: 0;
    }

    .hero__actions {
      flex-direction: row;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Yeni sezonu keşfet"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Rahat kalıplar, doğal tonlar, zamansız parçalar.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Koleksiyonu incele"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:labels.secondary_button"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:labels.secondary_link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "t:labels.hero_trust",
      "default": "Yıl boyu ücretsiz kargo Avela'da"
    }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
