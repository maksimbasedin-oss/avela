{% liquid
  assign show_offer = false
  if section.settings.heading != blank or section.settings.text != blank
    assign show_offer = true
  endif
  assign show_news = false
  if section.settings.newsletter_heading != blank or section.settings.newsletter_text != blank
    assign show_news = true
  endif
%}

{% if show_offer or show_news %}
  <div class="campaign-banner full-width">
    {% if section.settings.image != blank %}
      <div class="campaign-banner__bg" aria-hidden="true">
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: ''
        }}
      </div>
    {% endif %}
    <div class="campaign-banner__shade" aria-hidden="true"></div>

    <div class="campaign-banner__inner">
      {% if show_offer %}
        <div class="campaign-banner__head">
          <span class="campaign-banner__index" aria-hidden="true">0{{ section.index }}</span>
          {% if section.settings.eyebrow != blank %}
            <p class="eyebrow">{% render 'turkish-upper', text: section.settings.eyebrow %}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2>{% render 'turkish-upper', text: section.settings.heading %}</h2>
          {% endif %}
        </div>
      {% endif %}

      {% if show_news %}
        <div class="campaign-banner__news-head">
          {% if section.settings.newsletter_heading != blank %}
            <h2>{% render 'turkish-upper', text: section.settings.newsletter_heading %}</h2>
          {% endif %}
          {% if section.settings.newsletter_text != blank %}
            <div class="rte">{{ section.settings.newsletter_text }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="campaign-banner__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if show_news %}
        {% form 'customer', class: 'campaign-banner__form' %}
          {{ form.errors | default_errors }}
          {% if form.posted_successfully? %}
            <p class="campaign-banner__success">{{ 'newsletter.success' | t }}</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="field">
              <label class="field__label" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
              <input
                id="NewsletterEmail-{{ section.id }}"
                class="field__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
              >
            </div>
            <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
          {% endif %}
        {% endform %}
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="campaign-banner__cta">
          {% render 'button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            style: 'primary'
          %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .campaign-banner {
    position: relative;
    isolation: isolate;
    margin-block: 0;
    color: var(--color-background);
    background: var(--color-foreground);
  }

  .campaign-banner__bg,
  .campaign-banner__shade {
    position: absolute;
    inset: 0;
  }

  .campaign-banner__bg {
    z-index: 0;
  }

  .campaign-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .campaign-banner__shade {
    z-index: 1;
    background: rgb(17 17 17 / 0.62);
  }

  .campaign-banner__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--page-margin);
  }

  .campaign-banner__index {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    opacity: 0.55;
  }

  .campaign-banner h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    max-width: 16ch;
    line-height: 1.18;
    overflow-wrap: break-word;
  }

  .campaign-banner .eyebrow,
  .campaign-banner h2,
  .campaign-banner .rte,
  .campaign-banner .field__label,
  .campaign-banner__success {
    color: inherit;
  }

  .campaign-banner__text,
  .campaign-banner__news-head .rte {
    max-width: 36ch;
  }

  .campaign-banner__form,
  .campaign-banner__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }

  .campaign-banner .field__input {
    background: transparent;
    color: inherit;
    border-color: rgb(255 255 255 / 0.4);
  }

  .campaign-banner .button {
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    border-color: var(--color-background);
  }

  @media screen and (min-width: 750px) {
    .campaign-banner__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(4.75rem, auto) auto;
      column-gap: var(--space-2xl);
      align-items: stretch;
    }

    .campaign-banner__head {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }

    .campaign-banner__news-head {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }

    .campaign-banner__text {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      width: 100%;
      max-width: 24rem;
    }

    .campaign-banner__form {
      grid-column: 2;
      grid-row: 2 / 4;
      display: grid;
      grid-template-rows: auto 1fr auto;
      width: 100%;
      max-width: 24rem;
    }

    .campaign-banner__form .field,
    .campaign-banner__success {
      grid-row: 1;
    }

    .campaign-banner__form .button {
      grid-row: 3;
    }

    .campaign-banner__cta {
      grid-column: 1;
      grid-row: 3;
      width: 100%;
      max-width: 24rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.campaign",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.newsletter_heading",
      "default": "Yeni sezon notları"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "t:labels.newsletter_text",
      "default": "<p>Koleksiyon ve bakım notları. Spam yok.</p>"
    }
  ],
  "presets": [{ "name": "t:general.campaign" }]
}
{% endschema %}
