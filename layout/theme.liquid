<!doctype html>
<html lang="tr">
  <head>
    {% render 'css-variables' %}

    {% unless settings.type_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}
    {% render 'structured-data' %}

    {{ content_for_header }}
    <link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{ 'favicon-48.png' | asset_url }}" type="image/png" sizes="48x48">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}" sizes="180x180">
    <!-- Signalynn counter -->
    <script type="text/javascript">
      (function(m,e,t,r,i,k,a,s,j,n){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        s=e.getElementsByTagName(t);
        n=s.length;
        j=0;
        while(n-j){
          if(s[j].src===r){return;}
          j+=1;
        }
        k=e.createElement(t);
        k.async=1;
        k.src=r;
        a=e.head;
        if(!a){a=e.getElementsByTagName("head")[0];}
        if(a){a.appendChild(k);}
        else{e.documentElement.appendChild(k);}
      })(window,document,"script","https://signalynn.com/tracker/sy_ufs6a2sr65tysdxq.js","sy");
    </script>
    <!-- /Signalynn counter -->
  </head>

  <body>
    <a class="skip-link" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% render 'cookie-banner' %}
  </body>
</html>
