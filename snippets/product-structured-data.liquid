{% doc %}
  ProductGroup JSON-LD with a MerchantReturnPolicy on every Offer.
  Matches the store's 14-day unused, tagged return window on /pages/kargo-ve-iade.

  @example
  {% render 'product-structured-data' %}
{% enddoc %}

{% liquid
  assign brand_name = 'general.brand' | t
  if brand_name == blank or brand_name == 'general.brand'
    assign brand_name = shop.name
  endif

  assign site_url = shop.url
  if shop.domain contains 'myshopify.com'
    assign site_url = 'https://avelatr.com'
  endif

  assign return_path = '/pages/kargo-ve-iade'
  if pages['kargo-ve-iade'] != blank
    assign return_path = pages['kargo-ve-iade'].url
  endif
  assign return_url = site_url | append: return_path

  assign product_path = product.url | split: '?' | first
  assign product_abs = site_url | append: product_path
  assign currency_code = shop.currency | default: 'TRY'
%}

{%- capture return_policy_json -%}
{
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "TR",
        "returnPolicyCountry": "TR",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
        "refundType": "https://schema.org/FullRefund",
        "itemCondition": "https://schema.org/NewCondition",
        "url": {{ return_url | json }}
      }
{%- endcapture -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@id": {{ product_path | append: '#product' | json }},
    "@type": "ProductGroup",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | json }},
    "url": {{ product_abs | json }},
    "productGroupID": {{ product.id | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ brand_name | json }}
    }
    {%- if product.type != blank -%}
      ,"category": {{ product.type | json }}
    {%- endif -%}
    ,"hasVariant": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_path = variant.url
          assign variant_abs = site_url | append: variant.url
          assign variant_name = product.title
          if variant.title != 'Default Title'
            assign variant_name = product.title | append: ' - ' | append: variant.title
          endif
          assign variant_image = product.featured_image
          if variant.featured_image != blank
            assign variant_image = variant.featured_image
          endif
          assign availability = 'https://schema.org/OutOfStock'
          if variant.available
            assign availability = 'https://schema.org/InStock'
          endif
          assign price_major = variant.price | divided_by: 100
          assign price_minor = variant.price | modulo: 100 | prepend: '00' | slice: -2, 2
          assign schema_price = price_major | append: '.' | append: price_minor
        -%}
        {
          "@id": {{ variant_path | append: '#variant' | json }},
          "@type": "Product",
          "name": {{ variant_name | json }}
          {%- if variant_image != blank -%}
            ,"image": {{ variant_image | image_url: width: 1920 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if variant.sku != blank -%}
            ,"sku": {{ variant.sku | json }}
          {%- endif -%}
          ,"offers": {
            "@id": {{ variant_path | append: '#offer' | json }},
            "@type": "Offer",
            "url": {{ variant_abs | json }},
            "price": {{ schema_price | json }},
            "priceCurrency": {{ currency_code | json }},
            "availability": {{ availability | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "hasMerchantReturnPolicy": {{ return_policy_json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>
