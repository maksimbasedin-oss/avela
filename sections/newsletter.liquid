<div class="newsletter full-width">
  <div class="newsletter__copy">
    {% if section.settings.heading != blank %}
      <h2>{% render 'turkish-upper', text: section.settings.heading %}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rte">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% form 'customer', class: 'newsletter__form' %}
    {{ form.errors | default_errors }}
    {% if form.posted_successfully? %}
      <p>{{ 'newsletter.success' | t }}</p>
    {% else %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <label class="field__label" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          class="field__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
        >
      </div>
      <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
    {% endif %}
  {% endform %}
</div>

{% stylesheet %}
  .newsletter {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-2xl) var(--page-margin);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .newsletter h2,
  .newsletter .rte,
  .newsletter .field__label {
    color: inherit;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    max-width: 24rem;
  }

  .newsletter .field__input {
    background: transparent;
    color: var(--color-background);
    border-color: rgb(255 255 255 / 0.35);
  }

  .newsletter .button {
    background: var(--color-background);
    color: var(--color-foreground);
    border-color: var(--color-background);
  }

  @media screen and (min-width: 750px) {
    .newsletter {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Yeni sezon notları"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Koleksiyon ve bakım notları. Spam yok.</p>"
    }
  ],
  "presets": [{ "name": "t:general.newsletter" }]
}
{% endschema %}
