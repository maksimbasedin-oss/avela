<div class="customers customers--wide">
  <p><a href="{{ routes.account_url }}">{{ 'customers.account' | t }}</a></p>
  <h1>{{ 'customers.addresses' | t }}</h1>

  {% if customer.addresses.size > 0 %}
    <ul class="customers__orders" role="list">
      {% for address in customer.addresses %}
        <li>
          {{ address | format_address }}
          {% if address == customer.default_address %}
            <span>{{ 'customers.default_address' | t }}</span>
          {% endif %}
          {% form 'customer_address', address %}
            <button class="button button--text" type="submit">{{ 'customers.delete_address' | t }}</button>
            <input type="hidden" name="_method" value="delete">
          {% endform %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2>{{ 'customers.add_address' | t }}</h2>
  {% form 'customer_address', customer.new_address, class: 'customers__form' %}
    {{ form.errors | default_errors }}
    <div class="field">
      <label class="field__label" for="AddressFirst">{{ 'customers.first_name' | t }}</label>
      <input id="AddressFirst" class="field__input" type="text" name="address[first_name]" autocomplete="given-name">
    </div>
    <div class="field">
      <label class="field__label" for="AddressLast">{{ 'customers.last_name' | t }}</label>
      <input id="AddressLast" class="field__input" type="text" name="address[last_name]" autocomplete="family-name">
    </div>
    <div class="field">
      <label class="field__label" for="Address1">{{ 'customers.address1' | t }}</label>
      <input id="Address1" class="field__input" type="text" name="address[address1]" autocomplete="address-line1">
    </div>
    <div class="field">
      <label class="field__label" for="AddressCity">{{ 'customers.city' | t }}</label>
      <input id="AddressCity" class="field__input" type="text" name="address[city]" autocomplete="address-level2">
    </div>
    <div class="field">
      <label class="field__label" for="AddressZip">{{ 'customers.zip' | t }}</label>
      <input id="AddressZip" class="field__input" type="text" name="address[zip]" autocomplete="postal-code">
    </div>
    <div class="field">
      <label class="field__label" for="AddressPhone">{{ 'customers.phone' | t }}</label>
      <input id="AddressPhone" class="field__input" type="tel" name="address[phone]" autocomplete="tel">
    </div>
    <label>
      <input type="checkbox" name="address[default]">
      {{ 'customers.set_default' | t }}
    </label>
    <button class="button" type="submit">{{ 'customers.save' | t }}</button>
  {% endform %}
</div>

