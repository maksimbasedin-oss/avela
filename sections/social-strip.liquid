<div class="social-strip full-width band band--ash">
  {% assign follow_label = 'footer.follow' | t %}
  <p class="eyebrow">{% render 'turkish-upper', text: follow_label %}</p>
  {% render 'social-links', class: 'social-strip__list' %}
</div>

{% stylesheet %}
  .social-strip {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 2.75rem;
    padding-block: 0;
    border-top: 1px solid var(--color-foreground);
  }

  .social-strip .eyebrow {
    margin: 0;
    line-height: 1;
  }

  .social-strip__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-strip a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    font-size: 0.75rem;
  }

  @media screen and (max-width: 749px) {
    .social-strip,
    .social-strip__list {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.social",
  "settings": [],
  "presets": [{ "name": "t:general.social" }]
}
{% endschema %}
