<div class="customers">
  <h1>{{ 'customers.register' | t }}</h1>

  {% form 'create_customer', class: 'customers__form' %}
    {{ form.errors | default_errors }}
    <div class="field">
      <label class="field__label" for="RegisterFirst">{{ 'customers.first_name' | t }}</label>
      <input id="RegisterFirst" class="field__input" type="text" name="customer[first_name]" autocomplete="given-name">
    </div>
    <div class="field">
      <label class="field__label" for="RegisterLast">{{ 'customers.last_name' | t }}</label>
      <input id="RegisterLast" class="field__input" type="text" name="customer[last_name]" autocomplete="family-name">
    </div>
    <div class="field">
      <label class="field__label" for="RegisterEmail">{{ 'customers.login.email' | t }}</label>
      <input id="RegisterEmail" class="field__input" type="email" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="field">
      <label class="field__label" for="RegisterPassword">{{ 'customers.login.password' | t }}</label>
      <input
        id="RegisterPassword"
        class="field__input"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required
      >
    </div>
    <button class="button" type="submit">{{ 'customers.register' | t }}</button>
  {% endform %}

  <p>
    <a href="{{ routes.storefront_login_url }}">{{ 'customers.back_to_login' | t }}</a>
  </p>
</div>

