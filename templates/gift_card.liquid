{% layout none %}
<!doctype html>
<html lang="tr">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>
  <body>
    <main class="gift-card">
      <h1>{% render 'brand-name' %}</h1>
      <p class="gift-card__balance">{% render 'money', amount: gift_card.balance %}</p>

      {% if gift_card.enabled == false or gift_card.expired %}
        <p>{{ 'gift_card.expired' | t }}</p>
      {% endif %}

      {% if gift_card.expires_on %}
        {% assign expires_on = gift_card.expires_on | date: '%d.%m.%Y' %}
        <p>{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {% endif %}

      <p>{{ 'gift_card.use_at_checkout' | t }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="200"
            height="60"
          >
        </a>
      {% endif %}
    </main>
  </body>
</html>
