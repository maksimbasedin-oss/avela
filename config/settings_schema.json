  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:labels.heading_font",
        "default": "linotype_didot_n4"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "label": "t:labels.body_font",
        "default": "avenir_next_n4"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 2
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 2
      }
    ]
  },
