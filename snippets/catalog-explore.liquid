{% doc %}
  Kategori kısayolları. Yalnızca tüm ürünler koleksiyonunda kullanılır.

  @example
  {% render 'catalog-explore' %}
{% enddoc %}

{% liquid
  assign catalog_handles = 'yeni-sezon,tesettur-elbise,tesettur-takim,tesettur-tunik,tesettur-pantolon,dis-giyim,tesettur-abiye,sal-esarp,indirim' | split: ','
  assign catalog_count = 0
  for handle in catalog_handles
    assign catalog_collection = collections[handle]
    if catalog_collection != blank and catalog_collection.products_count > 0
      assign catalog_count = catalog_count | plus: 1
    endif
  endfor
%}

{% if catalog_count > 0 %}
  <nav class="catalog-explore" aria-label="{{ 'collections.shop_by' | t }}">
    <p class="eyebrow">{% assign shop_by = 'collections.shop_by' | t %}{% render 'turkish-upper', text: shop_by %}</p>
    <ul class="catalog-explore__list" role="list">
      {% for handle in catalog_handles %}
        {% assign catalog_collection = collections[handle] %}
        {% if catalog_collection != blank and catalog_collection.products_count > 0 %}
          <li>
            <a class="catalog-explore__card" href="{{ catalog_collection.url }}">
              {% render 'category-chip-icon', icon: 'auto', handle: catalog_collection.handle %}
              <span class="catalog-explore__copy">
                <span class="catalog-explore__title">
                  {% capture catalog_title %}
                    {% render 'storefront-title', text: catalog_collection.title, handle: catalog_collection.handle %}
                  {% endcapture %}
                  {% render 'turkish-upper', text: catalog_title %}
                </span>
                <span class="catalog-explore__count">{{ 'collections.product_count' | t: count: catalog_collection.products_count }}</span>
              </span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .catalog-explore {
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-foreground);
  }

  .catalog-explore__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    background: var(--color-foreground);
    border: 1px solid var(--color-foreground);
  }

  .catalog-explore__card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.75rem;
    padding: 0.85rem 0.9rem;
    background: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .catalog-explore .category-chips__icon {
    display: grid;
    place-items: center;
    flex: 0 0 3rem;
    box-sizing: border-box;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
  }

  .catalog-explore .category-chips__icon img,
  .catalog-explore .category-chips__icon svg {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 0.12rem;
    object-fit: contain;
  }

  .catalog-explore__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }

  .catalog-explore__title {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.25;
  }

  .catalog-explore__count {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
  }

  @media screen and (min-width: 750px) {
    .catalog-explore__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .catalog-explore__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
{% endstylesheet %}
