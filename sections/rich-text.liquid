{% liquid
  case section.settings.alignment
    when 'right'
      assign content_align = 'flex-end'
    when 'left'
      assign content_align = 'flex-start'
    else
      assign content_align = 'center'
  endcase
%}

<div
  class="rich-text"
  style="--text-align: {{ section.settings.alignment }}; --content-align: {{ content_align }}"
>
  {% if section.settings.eyebrow != blank %}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {% endif %}

  {% if section.settings.heading != blank %}
    <h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  {% if section.settings.text != blank %}
    <div class="rte rich-text__body">{{ section.settings.text }}</div>
  {% endif %}

  {% if section.settings.button_label != blank %}
    <div class="rich-text__actions">
      {% render 'button',
        label: section.settings.button_label,
        url: section.settings.button_link,
        style: section.settings.button_style
      %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .rich-text {
    display: flex;
    flex-direction: column;
    align-items: var(--content-align);
    gap: var(--space-md);
    padding-block: var(--space-2xl);
    text-align: var(--text-align);
    max-width: 40rem;
    margin-inline: auto;
  }

  .rich-text__heading {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: var(--font-heading--weight);
  }

  .rich-text__body {
    color: var(--color-secondary);
  }

  .rich-text__actions {
    display: flex;
    justify-content: var(--content-align);
    margin-block-start: var(--space-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Modern tesettür"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Sade kalıplar, doğal tonlar ve günlük konfor. Ürünler eklendiğinde koleksiyonlar burada görünür.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        { "value": "primary", "label": "t:options.button_style.primary" },
        { "value": "secondary", "label": "t:options.button_style.secondary" },
        { "value": "text", "label": "t:options.button_style.text" }
      ],
      "default": "primary"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:general.rich_text"
    }
  ]
}
{% endschema %}
