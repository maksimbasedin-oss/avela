{% doc %}
  Renders cart line items.

  @param {boolean} [show_quantity] - Show quantity inputs
  @example
  {% render 'cart-items' %}
{% enddoc %}

<ul class="cart-items" role="list">
  {% for item in cart.items %}
    <li class="cart-item">
      <a class="cart-item__media" href="{{ item.url }}">
        {% if item.image %}
          {{
            item.image
            | image_url: width: 240
            | image_tag:
              widths: '120, 180, 240',
              sizes: '80px',
              loading: 'lazy',
              alt: item.title
          }}
        {% endif %}
      </a>
      <div class="cart-item__info">
        <a href="{{ item.url }}">{{ item.product.title }}</a>
        {% unless item.product.has_only_default_variant %}
          <p class="text-caption">{{ item.variant.title }}</p>
        {% endunless %}
        {% render 'price', price: item.final_line_price %}
        {% if show_quantity %}
          <div class="cart-item__qty">
            <label class="visually-hidden" for="Updates-{{ item.key }}">{{ 'products.quantity' | t }}</label>
            <button type="button" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <input
              id="Updates-{{ item.key }}"
              class="field__input"
              type="number"
              name="updates[{{ item.key }}]"
              value="{{ item.quantity }}"
              min="0"
              data-cart-quantity
              data-line-key="{{ item.key }}"
            >
            <button type="button" data-qty-change="1" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
        {% endif %}
        <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove data-line-key="{{ item.key }}">
          {{ 'cart.remove' | t }}
        </a>
      </div>
    </li>
  {% endfor %}
</ul>

{% stylesheet %}
  .cart-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-sm);
  }

  .cart-item__media img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .cart-item__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .cart-item__info a {
    text-decoration: none;
  }

  .cart-item__qty {
    display: inline-flex;
    align-items: center;
    max-width: 8.5rem;
  }

  .cart-item__qty .field__input {
    text-align: center;
    border-radius: 0;
  }

  .cart-item__qty button {
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .cart-item__remove {
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
{% endstylesheet %}
