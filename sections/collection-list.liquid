{% liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
%}

{% if visible_blocks > 0 %}
  <div class="collection-list full-width">
    <div class="section-head">
      <span class="section-head__index">0{{ section.index }}</span>
      {% if section.settings.heading != blank %}
        <h2 class="collection-list__heading">{% render 'turkish-upper', text: section.settings.heading %}</h2>
      {% endif %}
    </div>

    <ul class="collection-list__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign card_collection = block.settings.collection
          if card_collection == blank and block.settings.handle != blank
            assign card_collection = collections[block.settings.handle]
          endif
        %}
        {% if card_collection != blank %}
          <li {{ block.shopify_attributes }}>
            {% liquid
              assign card_image = card_collection.featured_image
              if card_image == blank
                assign card_image = card_collection.products.first.featured_image
              endif
              assign card_alt = card_image.alt | default: card_collection.title
              capture card_title
                render 'storefront-title', text: card_collection.title, handle: card_collection.handle
              endcapture
              assign card_title = card_title | strip
              if card_alt == card_collection.title
                assign card_alt = card_title
              endif
              assign card_index = forloop.index | prepend: '0'
              if forloop.index > 9
                assign card_index = forloop.index
              endif
            %}
            <a
              class="collection-card{% if card_image == blank %} collection-card--plain{% endif %}"
              href="{{ card_collection.url }}"
            >
              <span class="collection-card__frame">
                {% if card_image %}
                  {{
                    card_image
                    | image_url: width: 600
                    | image_tag:
                      widths: '240, 360, 480, 600',
                      sizes: '(min-width: 750px) 172px, 50vw',
                      loading: 'lazy',
                      alt: card_alt
                  }}
                {% endif %}
                <span class="collection-card__index">{{ card_index }}</span>
              </span>
              <span class="collection-card__meta">
                <span class="collection-card__title">{% render 'turkish-upper', text: card_title, handle: card_collection.handle %}</span>
                <span class="collection-card__cta">
                  {{ 'collections.product_count' | t: count: card_collection.products_count }}
                  <span class="collection-card__shop"> · {{ 'collections.shop_now' | t }}</span>
                </span>
              </span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .collection-list {
    padding-block: var(--space-xl);
  }

  .collection-list .section-head {
    padding-inline: var(--page-margin);
  }

  .collection-list .section-head h2 {
    flex: 1;
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    margin: 0;
    background: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    border-inline: 0;
  }

  .collection-list .collection-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-foreground);
    text-decoration: none;
    color: var(--color-background);
  }

  .collection-list .collection-card__frame {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: var(--color-surface);
  }

  .collection-list .collection-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: none;
    opacity: 0.88;
  }

  .collection-list .collection-card__index {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    min-width: 1.6rem;
    padding: 0.2rem 0.35rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .collection-list .collection-card__meta {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-sm);
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), transparent);
    color: var(--color-background);
  }

  .collection-list .collection-card__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.05rem, 4.4vw, 1.55rem);
    letter-spacing: 0.04em;
    line-height: 1.15;
    overflow-wrap: break-word;
  }

  .collection-list .collection-card__cta {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: rgb(255 255 255 / 0.78);
  }

  .collection-list .collection-card--plain .collection-card__frame {
    background: var(--color-foreground);
  }

  @media screen and (min-width: 750px) {
    .collection-list {
      padding-inline: var(--page-margin);
    }

    .collection-list .section-head {
      padding-inline: 0;
    }

    .collection-list__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      justify-content: stretch;
      width: 100%;
      gap: 1.1rem 1.35rem;
      background: none;
      border: 0;
    }

    .collection-list .collection-card {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      aspect-ratio: auto;
      overflow: visible;
      background: transparent;
      color: var(--color-foreground);
    }

    .collection-list .collection-card__frame {
      position: relative;
      inset: auto;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--color-foreground);
    }

    .collection-list .collection-card img {
      filter: grayscale(0.12);
      opacity: 1;
    }

    .collection-list .collection-card__meta {
      position: static;
      padding: 0 0.05rem;
      background: none;
      color: var(--color-foreground);
    }

    .collection-list .collection-card__title {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    .collection-list .collection-card__cta {
      color: var(--color-secondary);
    }

    .collection-list .collection-card__shop {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .collection-list__grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 1.15rem 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Kategoriler"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
