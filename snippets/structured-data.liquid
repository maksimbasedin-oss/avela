{% doc %}
  Emits Organization and WebSite JSON-LD from live shop data.
{% enddoc %}

{% liquid
  assign brand_name = 'general.brand' | t
  if brand_name == blank or brand_name == 'general.brand'
    assign brand_name = shop.name
  endif
  assign organization = brand_name | json
  assign site_url = shop.url
  if shop.domain contains 'myshopify.com'
    assign site_url = 'https://www.avelatr.com'
  endif
  assign contact_email = settings.contact_email | default: 'info@avelatr.com'
  assign contact_phone = settings.contact_phone | default: '+90 536 498 47 27'
  assign contact_phone = contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  unless contact_phone contains '+'
    assign contact_phone = contact_phone | prepend: '+'
  endunless
  assign social_instagram = settings.social_instagram | default: 'https://www.instagram.com/avelatr'
  assign social_tiktok = settings.social_tiktok | default: 'https://www.tiktok.com/@avelatr'
  assign social_facebook = settings.social_facebook | default: 'https://www.facebook.com/avelatr'
  assign search_url = request.origin | append: routes.search_url | append: '?q={search_term_string}'
%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": {{ organization }},
        "legalName": "DESTEKTELEKOM BİLİŞİM HİZMETLERİ TİC. LTD. ŞTİ.",
        "taxID": "2930490482",
        "url": {{ site_url | json }},
        "email": {{ contact_email | json }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Değirmiçem Mah. Nişantaşı Sok. Tekerekoğlu İş Merkezi No: 2 Kat: 1 Daire: 44",
          "addressLocality": "Şehitkamil",
          "addressRegion": "Gaziantep",
          "addressCountry": "TR"
        }
        {%- if contact_phone != blank -%}
          ,"telephone": {{ contact_phone | json }}
        {%- endif -%}
        ,"sameAs": [
          {{ social_instagram | json }},
          {{ social_facebook | json }},
          {{ social_tiktok | json }}
        ]
        {%- if settings.logo != blank -%}
          ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
        {%- else -%}
          ,"logo": {{ 'logo-avela.png' | asset_url | prepend: 'https:' | json }}
        {%- endif -%}
        {%- liquid
          assign return_path = '/pages/kargo-ve-iade'
          if pages['kargo-ve-iade'] != blank
            assign return_path = pages['kargo-ve-iade'].url
          endif
          assign return_url = site_url | append: return_path
        -%}
        ,"hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "TR",
          "returnPolicyCountry": "TR",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
          "refundType": "https://schema.org/FullRefund",
          "itemCondition": "https://schema.org/NewCondition",
          "url": {{ return_url | json }}
        }
        ,"hasShippingService": {
          "@id": {{ return_url | append: '#shipping' | json }},
          "@type": "ShippingService",
          "name": "Türkiye içi kargo",
          "url": {{ return_url | json }},
          "shippingConditions": {
            "@type": "ShippingConditions",
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "TR"
            },
            "orderValue": {
              "@type": "MonetaryAmount",
              "minValue": 2000,
              "currency": "TRY"
            },
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 0,
              "currency": "TRY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 2,
              "maxValue": 5,
              "unitCode": "DAY"
            }
          }
        }
      },
      {
        "@type": "WebSite",
        "name": {{ organization }},
        "url": {{ site_url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_url | json }},
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
</script>

{%- if request.page_type == 'collection' and collection.handle != 'frontpage' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ page_title | default: collection.title | json }},
      "description": {{ page_description | default: collection.description | strip_html | json }},
      "url": {{ canonical_url | json }}
      {%- if collection.image != blank -%}
        ,"image": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
    }
  </script>
{%- elsif request.page_type == 'list-collections' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Tesettür Koleksiyonları | Avela",
      "description": "Tesettür elbise, takım, tunik, pantolon, dış giyim ve şal koleksiyonlarını inceleyin.",
      "url": {{ canonical_url | json }}
    }
  </script>
{%- elsif request.page_type == 'blog' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": {{ page_title | json }},
      "description": {{ page_description | default: '' | json }},
      "url": {{ canonical_url | json }}
    }
  </script>
{%- elsif request.page_type == 'page' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": {{ page_title | json }},
      "description": {{ page_description | default: '' | json }},
      "url": {{ canonical_url | json }}
    }
  </script>
{%- endif -%}
