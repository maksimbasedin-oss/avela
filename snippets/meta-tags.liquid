{% doc %}
  Renders document meta, Open Graph, canonical, and structured data.
{% enddoc %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.background_color }}">

{%- liquid
  assign brand_name = 'general.brand' | t
  if brand_name == blank or brand_name == 'general.brand'
    assign brand_name = shop.name
  endif
  assign display_title = page_title | default: brand_name
  case display_title
    when 'Products', 'All products', 'Catalog'
      assign display_title = 'search.products' | t
    when 'News'
      assign display_title = 'blog.news' | t
    when 'Search'
      assign display_title = 'search.title' | t
    when 'Your Shopping Cart', 'Shopping Cart', 'Cart'
      assign display_title = 'cart.title' | t
    when 'Account'
      assign display_title = 'customers.account' | t
    when 'Create Account'
      assign display_title = 'customers.register' | t
    when 'Reset Account'
      assign display_title = 'customers.forgot' | t
    when 'Home', 'Home page'
      assign display_title = 'general.home' | t
    when 'My Store', 'Mağazam'
      assign display_title = brand_name
  endcase
  assign home_seo_title = settings.seo_home_title | default: 'Avela | Tesettür Elbise, Takım ve Dış Giyim'
  assign home_seo_description = settings.seo_home_description | default: 'Tesettür elbise, takım, tunik, pantolon ve dış giyim. Bedenini seç, sepete at. Ücretsiz kargo Avela’da.'
  assign og_title = display_title
  assign seo_canonical = canonical_url
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: home_seo_description
  assign faceted_index = false

  if request.page_type == 'collection'
    if current_tags != blank
      assign faceted_index = true
    endif
    if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
      assign faceted_index = true
    endif
    for filter in collection.filters
      if filter.active_values.size > 0
        assign faceted_index = true
      endif
      for value in filter.values
        if value.active
          assign faceted_index = true
        endif
      endfor
      if filter.type == 'price_range'
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign faceted_index = true
        endif
      endif
    endfor
    if faceted_index
      assign seo_canonical = request.origin | append: collection.url
    endif
  endif

  if request.page_type == 'blog' and current_tags != blank
    assign faceted_index = true
    assign seo_canonical = request.origin | append: blog.url
  endif

  if request.page_type == 'index'
    assign raw_home_title = page_title | default: '' | downcase
    if page_title == blank or page_title == shop.name or page_title == brand_name or raw_home_title == 'avelatr.com' or raw_home_title contains 'myshopify.com' or page_title == shop.domain
      assign display_title = home_seo_title
      assign og_title = home_seo_title
    endif
    if page_description == blank or page_description == shop.name or page_description == brand_name
      assign og_description = home_seo_description
    endif
  elsif request.page_type == 'list-collections'
    assign display_title = 'Tesettür Koleksiyonları | Avela'
    assign og_title = display_title
    assign og_description = 'Tesettür elbise, takım, tunik, pantolon, dış giyim ve şal koleksiyonlarını inceleyin.'
  elsif request.page_type == 'collection' and collection.handle == 'all'
    assign display_title = 'Tüm Tesettür Ürünler | Avela'
    assign og_title = display_title
    assign og_description = 'Avela tesettür elbise, takım, tunik, pantolon ve dış giyim modellerinin tamamı.'
  elsif request.page_type == 'policy'
    if request.path contains 'privacy'
      assign display_title = 'Gizlilik Politikası | Avela'
      assign og_description = 'Avela kişisel verileri nasıl işler? Gizlilik politikasını okuyun.'
    elsif request.path contains 'terms'
      assign display_title = 'Kullanım Koşulları | Avela'
      assign og_description = 'avelatr.com alışveriş ve site kullanım koşullarını inceleyin.'
    else
      assign display_title = 'Teslimat ve İade | Avela'
      assign og_description = 'Avela kargo süresi, ücretsiz kargo eşiği ve 14 gün iade koşullarını inceleyin.'
    endif
    assign og_title = display_title
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign use_share_image = false
  if request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'collection'
    if page_image != blank
      assign share_image = page_image
      assign use_share_image = true
    endif
  endif
-%}

{%- liquid
  assign robots_noindex = false
  if request.page_type == 'search' or request.page_type == '404' or request.page_type == 'cart' or request.page_type == 'password' or request.page_type == 'policy' or faceted_index
    assign robots_noindex = true
  endif
  if request.page_type == 'product' and product.metafields.seo.hidden.value == 1
    assign robots_noindex = true
  elsif request.page_type == 'collection' and collection.metafields.seo.hidden.value == 1
    assign robots_noindex = true
  elsif request.page_type == 'page' and page.metafields.seo.hidden.value == 1
    assign robots_noindex = true
  elsif request.page_type == 'article' and article.metafields.seo.hidden.value == 1
    assign robots_noindex = true
  elsif request.page_type == 'blog' and blog.metafields.seo.hidden.value == 1
    assign robots_noindex = true
  endif
-%}
{%- if robots_noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/png" sizes="32x32">
<link rel="icon" href="{{ 'favicon-48.png' | asset_url }}" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}" sizes="180x180">

{%- if current_page != 1 -%}
  {%- assign og_title = display_title | append: ' – ' | append: current_page -%}
{%- endif -%}

<title>
  {{ display_title }}
  {%- unless faceted_index -%}
    {%- if current_page != 1 %} – {{ current_page }}{% endif -%}
  {%- endunless -%}
  {%- liquid
    assign title_check = display_title | downcase
    assign brand_check = brand_name | downcase
  -%}
  {%- if title_check contains brand_check -%}
  {%- else -%}
    – {{ brand_name }}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ seo_canonical }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

<meta
  property="og:site_name"
  content="{{ brand_name | escape }}"
>
<meta
  property="og:url"
  content="{{ seo_canonical | default: og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
{%- liquid
  assign og_locale = request.locale.iso_code | default: 'tr' | replace: '-', '_'
  if og_locale == 'tr'
    assign og_locale = 'tr_TR'
  endif
-%}
<meta
  property="og:locale"
  content="{{ og_locale }}"
>

{%- if use_share_image -%}
  <meta
    property="og:image"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="{{ share_image.height | times: 1200 | divided_by: share_image.width }}"
  >
  <meta
    name="twitter:image"
    content="https:{{ share_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:alt"
    content="{{ og_title | escape }}"
  >
  <meta
    name="twitter:image:alt"
    content="{{ og_title | escape }}"
  >
{%- else -%}
  <meta
    property="og:image"
    content="https:{{ 'social-card.png' | asset_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ 'social-card.png' | asset_url }}"
  >
  <meta
    property="og:image:width"
    content="640"
  >
  <meta
    property="og:image:height"
    content="537"
  >
  <meta
    property="og:image:alt"
    content="{{ brand_name | escape }}"
  >
  <meta
    name="twitter:image"
    content="https:{{ 'social-card.png' | asset_url }}"
  >
  <meta
    name="twitter:image:alt"
    content="{{ brand_name | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="TRY"
  >
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
