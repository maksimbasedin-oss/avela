{% javascript %}
  if (!customElements.get('header-bar')) {
    customElements.define(
      'header-bar',
      class HeaderBar extends HTMLElement {
        connectedCallback() {
          this.dialog = this.querySelector('dialog');
          this.querySelector('[data-open-search]')?.addEventListener('click', () => {
            this.dialog?.showModal();
            this.dialog?.querySelector('input[type="search"]')?.focus();
          });
          this.querySelector('[data-close-search]')?.addEventListener('click', () => this.dialog?.close());
          this.dialog?.addEventListener('click', (event) => {
            if (event.target === this.dialog) this.dialog.close();
          });
          this.dialog?.addEventListener('close', () => {
            this.dialog.classList.remove('is-searching');
            this.dialog.querySelector('[data-predictive-results]')?.replaceChildren();
          });
          this.querySelectorAll('[data-close-details]').forEach((button) => {
            button.addEventListener('click', () => button.closest('details')?.removeAttribute('open'));
          });
          this.closeDesktopMenus = (event) => {
            if (event.target.closest('.header-menu__accordion')) return;
            this.querySelectorAll('.header__desktop .header-menu__accordion[open]').forEach((item) => {
              item.removeAttribute('open');
            });
          };
          document.addEventListener('click', this.closeDesktopMenus);
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') this.closeDesktopMenus(event);
          });
          this.syncStickyOffset = this.syncStickyOffset.bind(this);
          this.syncStickyOffset();
          window.addEventListener('resize', this.syncStickyOffset, { passive: true });
          window.addEventListener('scroll', this.syncStickyOffset, { passive: true });
        }

        disconnectedCallback() {
          window.removeEventListener('resize', this.syncStickyOffset);
          window.removeEventListener('scroll', this.syncStickyOffset);
          document.removeEventListener('click', this.closeDesktopMenus);
        }

        syncStickyOffset() {
          if (this.stickyFrame) return;
          this.stickyFrame = requestAnimationFrame(() => {
            this.stickyFrame = null;
            const root = document.documentElement;
            const ticker = document.querySelector('[data-ticker]');
            const headerHeight = this.offsetHeight;
            root.style.setProperty('--header-height', `${headerHeight}px`);

            const headerBox = this.getBoundingClientRect();
            let offset = 0;
            if (headerBox.bottom > 0) {
              offset = headerBox.bottom;
            }

            if (ticker) {
              ticker.style.top = `${headerHeight}px`;
              const tickerBox = ticker.getBoundingClientRect();
              if (tickerBox.bottom > 0 && tickerBox.top <= offset + 1) {
                offset = tickerBox.bottom;
              }
            }

            root.style.setProperty('--sticky-offset', `${Math.max(0, Math.round(offset))}px`);
          });
        }
      }
    );
  }
{% endjavascript %}

